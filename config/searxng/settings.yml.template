# CodeAgent adaptive broad research engine overrides
# safe_research is still supported by startup scripts via SEARXNG_SAFE_KEEP_ONLY_ENGINES.
use_default_settings:
  engines:
    keep_only:
      - wikipedia
      - wikidata
      - arxiv
      - crossref
      - openalex
      - semantic scholar
      - github
      - stackoverflow
    remove:
      - startpage
      - bing
      - karmasearch
      - karmasearch videos
      - qwant
      - mojeek
      - yahoo

general:
  instance_name: "CodeAgent SearXNG"

search:
  formats:
    - html
    - json

server:
  bind_address: "__SEARXNG_BIND_ADDRESS__"
  port: __SEARXNG_PORT__
  base_url: "__SEARXNG_BASE_URL__"
  secret_key: "__SEARXNG_SECRET_KEY__"

# Runpod / single-container mode:
# Disable redis-dependent limiter by default to keep runtime lightweight.
botdetection:
  ip_limit:
    link_token: false
  ip_lists:
    block_ip: []
